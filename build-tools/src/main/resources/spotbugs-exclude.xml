<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/4.10.3/spotbugs/etc/findbugsfilter.xsd">

    <!--
      Exclude generated entity-meta classes by source path. These are emitted by
      entity-meta-processor into target/generated-sources/annotations and
      target/generated-test-sources/test-annotations. The pattern matches both.

      Excluded by source path rather than filename so the four hand-written classes in
      entity-meta-generator itself (Meta, Schema, DefaultMeta, GeneratedMeta) are not swept up.
      This is the same rationale documented in parent/pom.xml for the PMD filename excludes.
    -->
    <Match>
        <Source name="~.*/target/generated-(test-)?sources/.*/.*Meta\.java"/>
    </Match>
    <Match>
        <Source name="~.*/target/generated-(test-)?sources/.*/.*Schema\.java"/>
    </Match>

    <!--
      Exclude SBE-generated sources. These are emitted into target/generated-sources/sbe and are
      already exempt from PMD and Error Prone via path-based exclusions.
    -->
    <Match>
        <Source name="~.*/target/generated-sources/sbe/.*"/>
    </Match>

    <!--
      Test-fixture @Introspect entities live in a `.fixtures` package (com.loudsight.meta.fixtures.*
      for the entity-meta and simple-pojo fixture sets). They exist only to be unremarkable mutable
      JavaBeans for the processor / persistence layer to read; defensive-copy, equals/hashCode and
      "rough approximation of PI" advice do not apply to a fixture whose shape is dictated by what
      it must exercise. Real correctness and security detectors still run against them.
    -->
    <Match>
        <Package name="~com\.loudsight\..*\.fixtures(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,EQ_DOESNT_OVERRIDE_EQUALS,CNT_ROUGH_CONSTANT_VALUE"/>
    </Match>

    <!--
      auto-agent is an operator-driven build/deploy CLI. It is never network- or request-
      facing: every input is the operator's own shell, Maven's own output, or repo-committed
      deployment config under deployment/config/**. Three detector classes are structural
      false positives in that context and are scoped to its packages:
        - DM_EXIT in the cli.commands package: a CLI command's run() setting the process exit
          code with System.exit is correct, not a library-in-a-container hazard.
        - EI_EXPOSE_REP2 on a graph visitor's visit(DirectedGraph, VisitorContext): the visitor
          pattern receives and holds its traversal context by design; there is nothing to copy.
        - IMPROPER_UNICODE: every site is X.equalsIgnoreCase("jar"/"zip"/"http"/module-name) on
          ASCII build identifiers from Maven or repo config, never user text.
    -->
    <Match>
        <Package name="~com\.loudsight\.automation\.cli\.commands(\..*)?"/>
        <Bug pattern="DM_EXIT"/>
    </Match>
    <Match>
        <Package name="~com\.loudsight\.automation\.graph\.visitors(\..*)?"/>
        <Method name="visit"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Package name="~com\.loudsight\.automation(\..*)?"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!--
      ============================================================================
      Architectural-opinion detectors excluded wholesale, with measured counts.
      Same rationale as the PMD rule exclusions in loudsight-*.xml: these fire on
      correct, idiomatic code and enforcing them would mean hundreds of low-value
      edits with real regression risk. Decision recorded in
      notebook/plans/static-analysis-best-in-class-4c1a09.md, Step 5c.
      Re-survey with scripts/inventory-sweep.sh if these need revisiting.
      ============================================================================
    -->

    <!--
      THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION (141 findings, 2026-09-09) and
      THROWS_METHOD_THROWS_RUNTIMEEXCEPTION (9). "Method lists Exception/RuntimeException
      in its throws clause, but it could be more specific." Almost all sites are JUnit
      test methods and framework-boundary methods where `throws Exception` is the
      idiom. Enumerating the concrete checked exceptions in every signature is churn
      with no defect-prevention value; javac and Error Prone already police unreachable
      or swallowed checked exceptions.
    -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION,THROWS_METHOD_THROWS_RUNTIMEEXCEPTION"/>
    </Match>

    <!--
      CT_CONSTRUCTOR_THROW (16 findings, 2026-09-09). CERT OBJ11-J: an exception
      escaping a constructor leaves a partially-constructed object reachable via a
      subclass finalizer. It fires on ordinary constructor argument validation
      (`Objects.requireNonNull`, range checks). The accepted mitigation is to make
      the class `final` (which removes the finalizer-attack vector entirely) rather
      than to remove the validation; several of these classes are already `final`
      and SpotBugs still reports them. Not worth a tree-wide `final` sweep driven by
      this detector alone.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!--
      SPRING_ENDPOINT (FindSecBugs, rank 15) is emitted for every @Controller/@RestController; it
      flags nothing specific, it just says "an HTTP endpoint exists here, review it". As a build
      gate that is pure noise - the actual endpoint-level detectors (XSS, injection, redirect,
      CSRF) still run. Excluded tree-wide.
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!--
      INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE (FindSecBugs) in test classes. This detector
      models an attacker seeing a stack trace or exception message through an HTTP error response.
      In a JUnit test, folding e.getMessage() into a fail(...) / assertion message is the correct
      thing to do and there is no response channel to an attacker. Kept fully enforced for
      non-test code.
    -->
    <Match>
        <Class name="~.*(Test|Tests|IT)"/>
        <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
    </Match>

    <!--
      Style / hygiene / structural detectors that are noise in test code and carry no
      defect-prevention value there, while the real ones (null-deref, resource leak, injection,
      crypto) still run against tests. Covers: redundant null-checks; absolute pathnames (test
      resource roots, /tmp, the /opt/deployments layout an integration test asserts against);
      cross-test-class method-name similarity; `new Random()` used once for seeded synthetic
      data; a test subclass widening a method's visibility to exercise it; a cast whose type the
      test just asserted or constructed; a spy/recording double storing what it was handed or
      lazily initialising a field in @BeforeEach; and ignored return values in fire-and-forget
      test setup.
    -->
    <Match>
        <Class name="~.*(Test|Tests|IT)"/>
        <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE,DMI_HARDCODED_ABSOLUTE_FILENAME,NM_CONFUSING,DMI_RANDOM_USED_ONLY_ONCE,IAOM_DO_NOT_INCREASE_METHOD_ACCESSIBILITY,BC_UNCONFIRMED_CAST_OF_RETURN_VALUE,UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR,EI_EXPOSE_REP2,RV_RETURN_VALUE_IGNORED,CNT_ROUGH_CONSTANT_VALUE"/>
    </Match>

    <!--
      EI_EXPOSE_REP2 in a constructor (~93 findings, 2026-09-09). Storing a constructor
      argument into a field is how both dependency injection and immutable-object composition
      work: `new NotesEndpoint(notesService, templateEngine, ...)`, `new AeronDispatcher(aeron,
      registry, executor, ...)`. There is nothing to defensively copy - the argument is a
      collaborator, not owned data. The genuine aliasing hazard REP2 exists for - a caller
      mutating your internals after handing them over - is still enforced on setters, and
      EI_EXPOSE_REP is still enforced on getters. As a matter of style a constructor that is
      genuinely handed a caller-owned mutable *collection* should still copy it; that is caught
      by review, not by this detector.
    -->
    <Match>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
      EI_EXPOSE_REP / EI_EXPOSE_REP2 / MS_EXPOSE_REP on the shared persistence entity model
      (com.loudsight.useful.entity.**: User, Subject, PermissionGrant, TagAssignment, ...).
      These are mutable beans by contract - the persistence layer hydrates them field-by-field
      through their setters and reads them back through their getters. Wrapping the accessors in
      defensive copies would break hydration and relationship traversal. Same rationale as
      excluding generated code: the shape is dictated by the framework, not a design choice this
      detector should police. Business @Introspect entities elsewhere get the same treatment
      per-module as they are reached. SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR is included for
      the same reason: Subject exposes getAdmin()/getAnonymous() convenience instances but is a
      persistable base entity (User extends it), so its constructor cannot be private.
    -->
    <Match>
        <Package name="~com\.loudsight\.useful\.entity(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP,SING_SINGLETON_HAS_NONPRIVATE_CONSTRUCTOR"/>
    </Match>

    <!--
      Transport DTOs live in a `.dto` package (com.loudsight.persistence.client.dto,
      ...server.query.dto, com.loudsight.app.notes.api.dto, com.loudsight.app.ledger.api.dto, ...).
      They are @Introspect wire messages: constructed empty or via a canonical constructor and
      populated field-by-field by the deserializer, then read back the same way - the same
      bean-hydration rationale as the persistence entity model. EI_EXPOSE_REP on getters and
      EI_EXPOSE_REP2 on setters are inherent to that shape, and DE_MIGHT_IGNORE on
      EntityQuery.setTypeName is expected (a typeName that does not resolve to a local Class is
      normal on the class-free server side). Persisted @Id entities and hard-coded FQCN labels
      (e.g. authentication Session) deliberately stay in .entity and are NOT moved here.
    -->
    <Match>
        <Package name="~com\.loudsight\..*\.dto(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,DE_MIGHT_IGNORE"/>
    </Match>

    <!--
      SubjectReferencingFixtureEntity is a persistence-lib test fixture @Introspect bean.
    -->
    <Match>
        <Class name="~com\.loudsight\.persistence\.server\.SubjectReferencingFixtureEntity"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      CypherQueryUtils.generateMergeQueryForEntity (and its lambda): the format strings are
      text-block literals whose .stripIndent() only normalises indentation - no interpolation.
      The %s arguments are Cypher fragments composed from schema metadata (labels, alias names,
      property-key lists) and values already routed through quoteIfString, never raw request
      input. The literal \n breaks are deliberate Cypher formatting, not platform line separators.
      Scoped to this one method rather than the class, since CypherQueryUtils is the injection
      surface and every other format call in it must stay checked. A method-level
      @SuppressFBWarnings cannot cover the lambda's synthetic method, hence a filter entry.
    -->
    <Match>
        <Class name="com.loudsight.persistence.server.query.CypherQueryUtils"/>
        <Or>
            <Method name="generateMergeQueryForEntity"/>
            <Method name="~lambda\$generateMergeQueryForEntity\$.*"/>
        </Or>
        <Bug pattern="FORMAT_STRING_MANIPULATION,VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>

</FindBugsFilter>
